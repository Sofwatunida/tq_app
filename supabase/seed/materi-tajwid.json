  "ayat": [
    {
      "surah": 14,
      "nomor_ayat": 16,
      "teks_arab": "مِّنْ وَّرَاۤىِٕهٖ جَهَنَّمُ وَيُسْقٰى مِنْ مَّاۤءٍ صَدِيْدٍ",
      "terjemahan": "Di hadapannya ada (neraka) Jahanam dan dia akan diberi minuman dengan air nanah.",
      "audio_url": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/014016.mp3"
    },
    {
      "surah": 3,
      "nomor_ayat": 60,
      "teks_arab": "اَلْحَقُّ مِنْ رَّبِّكَ فَلَا تَكُنْ مِّنَ الْمُمْتَرِيْنَ",
      "terjemahan": "Kebenaran itu dari Tuhanmu. Oleh karena itu, janganlah engkau (Nabi Muhammad) termasuk orang-orang yang ragu.",
      "audio_url": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/003060.mp3"
    },
    {
      "surah": 69,
      "nomor_ayat": 8,
      "teks_arab": "فَهَلْ تَرٰى لَهُمْ مِّنْۢ بَاقِيَةٍ",
      "terjemahan": "Adakah kamu melihat seorang pun yang masih tersisa di antara mereka?",
      "audio_url": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/069008.mp3"
    },
    {
      "surah": 20,
      "nomor_ayat": 4,
      "teks_arab": "تَنْزِيْلًا مِّمَّنْ خَلَقَ الْاَرْضَ وَالسَّمٰوٰتِ الْعُلٰى",
      "terjemahan": "(Al-Qur’an) diturunkan dari (Allah) yang telah menciptakan bumi dan langit yang tinggi.",
      "audio_url": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/020004.mp3"
    },
    {
      "surah": 15,
      "nomor_ayat": 62,
      "teks_arab": "قَالَ اِنَّكُمْ قَوْمٌ مُّنْكَرُوْنَ",
      "terjemahan": "dia berkata, “Sesungguhnya kamu orang-orang yang tidak kami kenal.”",
      "audio_url": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/015062.mp3"
    },
    {
      "surah": 113,
      "nomor_ayat": 2,
      "teks_arab": "مِنْ شَرِّ مَا خَلَقَ",
      "terjemahan": "dari kejahatan (makhluk yang) Dia ciptakan,",
      "audio_url": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/113002.mp3"
    },
    {
      "surah": 79,
      "nomor_ayat": 14,
      "teks_arab": "فَاِذَا هُمْ بِالسَّاهِرَةِ",
      "terjemahan": "Seketika itu, mereka hidup kembali di bumi (yang baru).",
      "audio_url": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/079014.mp3"
    },
    {
      "surah": 10,
      "nomor_ayat": 86,
      "teks_arab": "وَنَجِّنَا بِرَحْمَتِكَ مِنَ الْقَوْمِ الْكٰفِرِيْنَ",
      "terjemahan": "Selamatkanlah pula kami dengan rahmat-Mu dari kaum yang kafir.”",
      "audio_url": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/010086.mp3"
    },
    {
      "surah": 91,
      "nomor_ayat": 1,
      "teks_arab": "وَالشَّمْسِ وَضُحٰىهَا",
      "terjemahan": "Demi matahari dan sinarnya pada waktu duha (ketika matahari naik sepenggalah),",
      "audio_url": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/091001.mp3"
    }
